root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{ts,tsx,js,json,yml,yaml,xml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# Nullable reference types already force callers to pass non-null, so the extra
# runtime guard this rule asks for would be dead code.
dotnet_diagnostic.CA1062.severity = none

# The library is not localised and the exception messages are developer facing.
dotnet_diagnostic.CA1303.severity = none

# Domain exceptions always name the rule that was broken, so the parameterless
# constructor this rule asks for would allow a violation with nothing to report.
dotnet_diagnostic.CA1032.severity = none

# Status values mirror Dataverse choice columns, which are numbered from one.
# A zero member would map to a state the platform cannot represent.
dotnet_diagnostic.CA1008.severity = none

# Types registered in the container are constructed by reflection, which this
# rule cannot see, so it reports every one of them as unused.
dotnet_diagnostic.CA1812.severity = none

[tests/**/*.cs]
# Test names use underscores to separate the subject from the expectation.
dotnet_diagnostic.CA1707.severity = none

# The test runner has no synchronization context to capture, so ConfigureAwait
# would add noise without preventing anything.
dotnet_diagnostic.CA2007.severity = none
