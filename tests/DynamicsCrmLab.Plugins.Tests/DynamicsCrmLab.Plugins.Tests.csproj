<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the plug-in, which the Dataverse sandbox pins to 4.6.2. -->
    <TargetFramework>net462</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CS0618: FakeXrmEasy 1.x marks its own API obsolete to push users towards
      2.x and 3.x. Those need a paid licence for commercial use, while 1.x stays
      free and still models the sandbox faithfully enough for these tests.
    -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="FakeXrmEasy.9" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DynamicsCrmLab.Plugins\DynamicsCrmLab.Plugins.csproj" />
    <!--
      The plug-in project keeps these to itself so that they travel inside its
      package rather than as package dependencies, so the tests ask for them.
    -->
    <ProjectReference Include="..\..\src\DynamicsCrmLab.Domain\DynamicsCrmLab.Domain.csproj" />
    <ProjectReference Include="..\..\src\DynamicsCrmLab.Schema\DynamicsCrmLab.Schema.csproj" />
  </ItemGroup>

</Project>
