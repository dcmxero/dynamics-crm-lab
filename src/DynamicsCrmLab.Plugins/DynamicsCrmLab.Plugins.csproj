<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The Dataverse sandbox only loads assemblies built for .NET Framework 4.6.2.
      Not .NET 8 or 10. This is the single most common beginner mistake.
    -->
    <TargetFramework>net462</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../build/DynamicsCrmLab.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies">
      <!-- Present in the sandbox already, so it must not ship with the plug-in. -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamicsCrmLab.Domain\DynamicsCrmLab.Domain.csproj" />
    <ProjectReference Include="..\DynamicsCrmLab.Schema\DynamicsCrmLab.Schema.csproj" />
  </ItemGroup>

</Project>
