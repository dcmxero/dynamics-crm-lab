<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Reachable from both sides of the fence: the net10.0 client and the
      netstandard2.0 build the plug-in consumes.
    -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../build/DynamicsCrmLab.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
